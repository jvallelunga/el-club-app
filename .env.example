# Copiá este archivo a .env.local. Las claves no van al repo.

# Proyecto de Supabase de desarrollo (el-club-app-desarrollo).
NEXT_PUBLIC_SUPABASE_URL=
# Clave anónima (anon) o publishable del proyecto.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo para tareas de administración fuera de la app (no hace falta en Vercel).
# SUPABASE_SERVICE_ROLE_KEY=

# Hosts de la app en sí, separados por coma (además de localhost y los de Vercel).
# No se interpretan como dominio de un club.
# NEXT_PUBLIC_DOMINIOS_PRODUCTO=

# El login con Google se configura en el panel de Supabase Auth, no acá.

# Clave de la Google Map Tiles API (satélite del editor de predios, #26).
# Restringida a Map Tiles API y a los dominios de la app, con tope diario de
# pedidos para no salir del cupo gratis. Sin clave, el mapa usa Esri.
# Se configura con: bash scripts/configurar-google-map-tiles.sh
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
