%% El Club — modelo aplicado.
%% Tablas migradas: club (con dominio_base, escudo_ruta y paleta), usuario, super_admin,
%% super_admin_invitacion, club_miembro, club_invitacion, club_red_social,
%% sede, instalacion, predio y elemento_predio.
%% usuario.id coincide con el usuario de Supabase Auth.
%% rol_club es un enum que por ahora solo tiene el valor admin.
%%
%% El dominio raíz del club (club.dominio_base, ej. clubejemplo.com.ar)
%% es el SITIO WEB del club. La app vive en subdominios por superficie
%% (admin.<dominio_base>, vivo.<dominio_base>), resueltos en código.
%% Sin dominio propio, el fallback es /c/<slug>/<superficie>.
%%
%% club.escudo_ruta es la ruta en el bucket público escudos
%% (p. ej. <id>/escudo.png). La paleta tiene color_principal (obligatorio),
%% color_claro (default #ffffff) y color_2 / color_3 opcionales
%% (null = se derivan en la app).
%% public.marca_publica_del_club(slug o dominio_base) expone nombre,
%% escudo y paleta para el ingreso y el tema, también sin sesión.
%%
%% Un Admin puede invitar y quitar Admins solo de su club
%% (interno.es_admin_club). No se puede quitar al último Admin.
%% Un Admin también puede actualizar los datos estéticos de su club
%% (nombre, escudo_ruta, paleta) y el contacto (telefono, email,
%% direccion, web y club_red_social). slug y dominio_base solo los
%% cambia el Super Admin (trigger impedir_cambio_de_rutas_del_club).
%% Un club tiene sedes; cada sede tiene instalaciones. instalacion.tipo
%% es la clave de un tipo de instalación definido en código
%% (src/dominio/tipos-instalacion.ts, ADR 0001); «otra» es un bloque
%% genérico. La base solo acepta esas claves (instalacion_tipo_check).
%% Una sede tiene a lo sumo un predio (#42): origen_lat/origen_lng es el
%% origen del predio y area, el área del predio como lista jsonb de puntos
%% [este, norte] en metros desde el origen. Escribe solo el Super Admin;
%% leen los Admins del club.
%% elemento_predio (#43) es lo ubicado en el predio: una instalación
%% de la sede, a lo sumo una vez cada una (instalacion_id único; si se borra
%% la instalación, sale del predio). este/norte es el centro en metros desde
%% el origen, rotacion en grados (sentido horario, 0 a 360) y medidas, un
%% jsonb con las medidas del tipo. Mismo RLS que predio. Se guarda junto con
%% el área con public.guardar_predio().
%% La leyenda (#45): descripcion es un texto corto (hasta 280 caracteres) que
%% se ve en la leyenda, distinto de las notas de la instalación. orden_leyenda
%% es el lugar en la leyenda (1, 2, 3…, único por predio) o null si no entra;
%% en_leyenda se calcula de él. El número que se ve es el puesto en ese orden.
%% Elementos de referencia (#46): un elemento_predio es una instalación
%% (instalacion_id) o un elemento de referencia (tipo_referencia), nunca las
%% dos. tipo_referencia es la clave de un tipo definido en código
%% (src/dominio/tipos-referencia.ts: arbol, piedra, bebedero, gradas,
%% tribuna, camino, valla); la base solo acepta esas claves. nombre es el
%% nombre propio opcional de un elemento de referencia (hasta 60 caracteres).
%% Se guardan con guardar_predio(), que recibe también p_referencias.
%% Caminos y vallas (#47): en vez de este/norte/rotacion (null) guardan
%% puntos, una lista jsonb de 2 a 500 puntos [este, norte] en metros desde el
%% origen; medidas lleva el ancho del camino o el alto de la valla.
%% El email del Super Admin no se guarda en el repo: el alta se hace
%% directo en la base (ver scripts/sembrar-super-admin.sql).
erDiagram
    CLUB {
        uuid id PK
        string slug UK
        string nombre
        string dominio_base UK
        string escudo_ruta
        string color_principal
        string color_claro
        string color_2
        string color_3
        string telefono
        string email
        string direccion
        string web
        timestamptz creado_en
    }
    CLUB_RED_SOCIAL {
        uuid id PK
        uuid club_id FK
        string red
        string etiqueta
        string valor
        int orden
        timestamptz creado_en
    }
    SEDE {
        uuid id PK
        uuid club_id FK
        string nombre
        string direccion
        string maps_url
        timestamptz creado_en
    }
    INSTALACION {
        uuid id PK
        uuid sede_id FK
        string tipo
        string nombre
        string notas
        timestamptz creado_en
    }
    PREDIO {
        uuid id PK
        uuid sede_id FK,UK
        float origen_lat
        float origen_lng
        jsonb area
        timestamptz creado_en
        timestamptz actualizado_en
    }
    ELEMENTO_PREDIO {
        uuid id PK
        uuid predio_id FK
        uuid instalacion_id FK,UK
        string tipo_referencia
        string nombre
        float este
        float norte
        float rotacion
        jsonb puntos
        jsonb medidas
        string descripcion
        int orden_leyenda
        boolean en_leyenda
        timestamptz creado_en
        timestamptz actualizado_en
    }
    USUARIO {
        uuid id PK
        string nombre
        string email UK
        timestamptz creado_en
    }
    SUPER_ADMIN {
        uuid usuario_id PK
        timestamptz creado_en
    }
    SUPER_ADMIN_INVITACION {
        uuid id PK
        string email UK
        timestamptz creado_en
    }
    CLUB_MIEMBRO {
        uuid id PK
        uuid club_id FK
        uuid usuario_id FK
        rol_club rol
        timestamptz creado_en
    }
    CLUB_INVITACION {
        uuid id PK
        uuid club_id FK
        string email
        rol_club rol
        timestamptz creado_en
        timestamptz aceptada_en
    }
    CLUB ||--o{ CLUB_MIEMBRO : tiene
    USUARIO ||--o{ CLUB_MIEMBRO : integra
    USUARIO ||--o| SUPER_ADMIN : es
    CLUB ||--o{ CLUB_INVITACION : invita
    CLUB ||--o{ CLUB_RED_SOCIAL : tiene
    CLUB ||--o{ SEDE : tiene
    SEDE ||--o{ INSTALACION : tiene
    SEDE ||--o| PREDIO : tiene
    PREDIO ||--o{ ELEMENTO_PREDIO : ubica
    INSTALACION ||--o| ELEMENTO_PREDIO : "se ubica en"
