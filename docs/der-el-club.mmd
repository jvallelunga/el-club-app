%% El Club — modelo aplicado.
%% Tablas migradas: club (con dominio_base, escudo_ruta y paleta), usuario, super_admin,
%% super_admin_invitacion, club_miembro, club_invitacion, club_red_social,
%% sede, tipo_instalacion e instalacion.
%% usuario.id coincide con el usuario de Supabase Auth.
%% rol_club es un enum que por ahora solo tiene el valor admin.
%%
%% El dominio raíz del club (club.dominio_base, ej. clubejemplo.com.ar)
%% es el SITIO WEB del club. La app vive en subdominios por superficie
%% (admin.<dominio_base>, vivo.<dominio_base>), resueltos en código.
%% Sin dominio propio, el fallback es /c/<slug>/<superficie>.
%%
%% club.escudo_ruta es la ruta en el bucket público escudos
%% (p. ej. <id>/escudo.png). La paleta tiene color_principal (obligatorio),
%% color_claro (default #ffffff) y color_2 / color_3 opcionales
%% (null = se derivan en la app).
%% public.marca_publica_del_club(slug o dominio_base) expone nombre,
%% escudo y paleta para el ingreso y el tema, también sin sesión.
%%
%% Un Admin puede invitar y quitar Admins solo de su club
%% (interno.es_admin_club). No se puede quitar al último Admin.
%% Un Admin también puede actualizar los datos estéticos de su club
%% (nombre, escudo_ruta, paleta) y el contacto (telefono, email,
%% direccion, web y club_red_social). slug y dominio_base solo los
%% cambia el Super Admin (trigger impedir_cambio_de_rutas_del_club).
%% Un club tiene sedes; cada sede tiene instalaciones. tipo_instalacion
%% con club_id null son los tipos de base (solo el Super Admin los
%% edita); un club_id es un tipo propio de ese club.
%% El email del Super Admin no se guarda en el repo: el alta se hace
%% directo en la base (ver scripts/sembrar-super-admin.sql).
erDiagram
    CLUB {
        uuid id PK
        string slug UK
        string nombre
        string dominio_base UK
        string escudo_ruta
        string color_principal
        string color_claro
        string color_2
        string color_3
        string telefono
        string email
        string direccion
        string web
        timestamptz creado_en
    }
    CLUB_RED_SOCIAL {
        uuid id PK
        uuid club_id FK
        string red
        string etiqueta
        string valor
        int orden
        timestamptz creado_en
    }
    SEDE {
        uuid id PK
        uuid club_id FK
        string nombre
        string direccion
        string maps_url
        timestamptz creado_en
    }
    TIPO_INSTALACION {
        uuid id PK
        uuid club_id FK
        string nombre
        timestamptz creado_en
    }
    INSTALACION {
        uuid id PK
        uuid sede_id FK
        uuid tipo_instalacion_id FK
        string nombre
        string notas
        timestamptz creado_en
    }
    USUARIO {
        uuid id PK
        string nombre
        string email UK
        timestamptz creado_en
    }
    SUPER_ADMIN {
        uuid usuario_id PK
        timestamptz creado_en
    }
    SUPER_ADMIN_INVITACION {
        uuid id PK
        string email UK
        timestamptz creado_en
    }
    CLUB_MIEMBRO {
        uuid id PK
        uuid club_id FK
        uuid usuario_id FK
        rol_club rol
        timestamptz creado_en
    }
    CLUB_INVITACION {
        uuid id PK
        uuid club_id FK
        string email
        rol_club rol
        timestamptz creado_en
        timestamptz aceptada_en
    }
    CLUB ||--o{ CLUB_MIEMBRO : tiene
    USUARIO ||--o{ CLUB_MIEMBRO : integra
    USUARIO ||--o| SUPER_ADMIN : es
    CLUB ||--o{ CLUB_INVITACION : invita
    CLUB ||--o{ CLUB_RED_SOCIAL : tiene
    CLUB ||--o{ SEDE : tiene
    CLUB ||--o{ TIPO_INSTALACION : puede_definir
    SEDE ||--o{ INSTALACION : tiene
    TIPO_INSTALACION ||--o{ INSTALACION : clasifica
